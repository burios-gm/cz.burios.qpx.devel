<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>cz.burios.qpx.devel</groupId>
		<artifactId>cz.burios.qpx.devel</artifactId>
		<version>26.2-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>
	<artifactId>cz.burios.qpx.desktop</artifactId>
	<packaging>war</packaging>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>17</java.version>
		<spring.version>6.0.3</spring.version>
		<jersey.version>3.0.1</jersey.version>
	</properties>

	<dependencies>
		<!-- Jakarta Persistence API -->
		<dependency>
			<groupId>jakarta.persistence</groupId>
			<artifactId>jakarta.persistence-api</artifactId>
			<version>3.1.0</version>
		</dependency>

		<!-- MySQL JDBC Driver -->
		<dependency>
			<groupId>mysql</groupId>
			<artifactId>mysql-connector-java</artifactId>
			<version>5.1.38</version>
		</dependency>

		<!-- UniQL database and data access library -->
		<dependency>
			<groupId>cz.burios.qpx.devel</groupId>
			<artifactId>cz.burios.uniql</artifactId>
			<version>26.2-SNAPSHOT</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.2.3</version>
				<configuration>
					<warName>devel</warName>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
